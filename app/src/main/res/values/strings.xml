    <!-- Certificates and HTTP -->
    <string name="cert_title">Trust this certificate?</string>
    <string name="cert_changed_title">Certificate changed</string>
    <string name="cert_changed_warning">%1$s now presents a different certificate from the one you trusted. Only continue if you replaced or renewed it yourself.</string>
    <string name="cert_intro">%1$s uses a certificate your phone doesn\'t know, like the self-signed certificate OpenWrt creates for HTTPS.</string>
    <string name="cert_check">Check that this SHA-256 fingerprint matches your router\'s (on the router, run: openssl x509 -in /etc/uhttpd.crt -noout -fingerprint -sha256):</string>
    <string name="cert_issued_to">Issued to: %1$s</string>
    <string name="cert_pin_note">From now on WrtCtrl only accepts this exact certificate from this router.</string>
    <string name="cert_trust">Trust</string>
    <string name="cert_pinned">Trusted certificate (pinned)</string>
    <string name="cert_system">Certificate trusted by the phone</string>
    <string name="http_title">Use an unencrypted connection?</string>
    <string name="http_body">%1$s is an http:// address. Then your router password, your session and everything WrtCtrl shows and changes are sent unencrypted, and anyone on the network can read them. That\'s fine on your home network or a VPN, but risky anywhere else. WrtCtrl only uses HTTP for this address.</string>
