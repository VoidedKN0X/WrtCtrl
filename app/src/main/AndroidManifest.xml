<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Hides other apps' floating windows while the PIN, a key or password, or a confirm screen shows.
         Granted at install, no prompt. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- androidx.biometric adds the old fingerprint permission, which only Android 8 and older use. WrtCtrl needs
         Android 15, where USE_BIOMETRIC above is what the fingerprint unlock uses, so it's removed. -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
    <!-- WorkManager adds the foreground-service permission for long jobs shown as a notification. The background
         checks and widget refreshes are short jobs that never run as a foreground service, so it's removed (with
         WorkManager's foreground service below). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <queries>
        <!-- ntfy, the only push app WrtCtrl uses. -->
        <package android:name="io.heckel.ntfy" />
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
        <!-- AdCtrl: "Open in AdCtrl" on a device's page when it's installed. -->
        <package android:name="com.vknxworks.adctrl" />
    </queries>

    <application
        android:intentMatchingFlags="enforceIntentFilter"
        android:name=".WrtCtrlApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.WrtCtrl">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The launcher shortcuts (res/xml/shortcuts.xml), so strict intent matching lets them through. -->
            <intent-filter>
                <action android:name="com.vknxworks.wrtctrl.CLIENTS" />
                <action android:name="com.vknxworks.wrtctrl.GUEST_WIFI" />
                <action android:name="com.vknxworks.wrtctrl.REBOOT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Push from ntfy: only a wake-up call for the background check. Exported because ntfy is another
             app; every broadcast must carry the secret token of WrtCtrl's registration or it's ignored. -->
        <receiver
            android:name=".data.notify.PushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
            </intent-filter>
        </receiver>
        <!-- ntfy binds to this for a few seconds before delivering a message, so the check can start at once. -->
        <service
            android:name=".data.notify.RaiseToForegroundService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.RAISE_TO_FOREGROUND" />
            </intent-filter>
        </service>

        <!-- Home-screen widget (Glance): WAN status, throughput and online clients. -->
        <receiver
            android:name=".ui.widgets.RouterWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- The rest of what Android's widget host sends, so strict intent matching lets it through. -->
                <action android:name="android.appwidget.action.APPWIDGET_ENABLED" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLED" />
                <action android:name="android.appwidget.action.APPWIDGET_DELETED" />
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE_OPTIONS" />
                <action android:name="android.appwidget.action.APPWIDGET_RESTORED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_router_info" />
        </receiver>

        <!-- Quick Settings tile: guest Wi-Fi on or off. -->
        <service
            android:name=".ui.widgets.GuestWifiTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_guest_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!-- WorkManager's foreground service, for long jobs shown as a notification. WrtCtrl never uses it. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
        <!-- WorkManager's diagnostics hook (only for adb dumps) isn't needed in the app. -->
        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />
        <!-- AndroidX's profile installer receiver lets other apps ask WrtCtrl to write or skip its
             ART profile; it isn't needed, so leave it out. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
        <!-- Don't let androidx.emoji2 look up a downloadable emoji font at start-up: emoji are drawn with the
             phone's own emoji font, and nothing is fetched. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
